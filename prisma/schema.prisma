generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Content {
  id                Int      @id @default(autoincrement())
  name              String
  kicker            String
  bio               String
  releaseKicker     String
  releaseTitle      String
  releaseUrl        String
  coverUrl          String   @default("")
  footer            String
  contactLabel      String
  contactUrl        String
  aboutTitle        String
  aboutText         String
  aboutPhoto        String   @default("")
  videoUrl          String   @default("")
  bgUrl             String   @default("")
  avatarUrl         String   @default("")
  overlay           Float    @default(0.62)
  accent            String   @default("#6d1420")
  font              String   @default("instrument")
  layout            String   @default("background")
  showTour          Boolean  @default(true)
  googleAnalyticsCode String @default("")
  yandexMetrikaCode   String @default("")
  instagramUrl      String   @default("")
  telegramUrl       String   @default("")
  tiktokUrl         String   @default("")
  youtubeUrl        String   @default("")
  threadsUrl        String   @default("")
  xUrl              String   @default("")
  updatedAt         DateTime @updatedAt
}

model Album {
  id        Int      @id @default(1)
  title     String   @default("")
  coverUrl  String   @default("")
  text      String   @default("")
  singles   Json     @default("[]")
  platforms Json     @default("[]")
  videos    Json     @default("[]")
  photos    Json     @default("[]")
}

model Link {
  id    String @id @default(cuid())
  label String
  url   String
  tag   String @default("")
  order Int    @default(0)
}

model Blog {
  id    Int  @id @default(1)
  posts Json @default("[]")
}

model MediaArchive {
  id    Int  @id @default(1)
  items Json @default("[]")
}

model MenuItem {
  id    String @id @default(cuid())
  label String
  url   String
  order Int    @default(0)
}

model TourDate {
  id    String @id @default(cuid())
  date  String
  city  String
  venue String
  url   String
  order Int    @default(0)
}

model Click {
  id    String @id
  count Int    @default(0)
}

model AdminUser {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
}
